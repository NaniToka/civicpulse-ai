# CivicPulse AI Environment Configuration Template
# DO NOT ADD SENSITIVE API KEYS TO THIS FILE.
# Copy this file to .env for local development.

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security & API Protection
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-string
MAX_BODY_SIZE_BYTES=10485760

# AI Configuration (Google Gemini)
# Leave blank or unconfigured to activate Graceful Fallback Mode for local development/offline testing
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Database Configuration (PostgreSQL / PostGIS ready)
DATABASE_URL=postgresql://civicpulse:civicpulse_secret@localhost:5432/civicpulse_db
