# ==============================================================================
# CIVICPULSE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development.
# WARNING: DO NOT COMMIT REAL SECRETS OR API KEYS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Environment
# ------------------------------------------------------------------------------
# Controls runtime mode ('development' or 'production'). Default: development
ENVIRONMENT=development

# Log level ('DEBUG', 'INFO', 'WARNING', 'ERROR'). Default: INFO
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Backend Server & Security Configuration
# ------------------------------------------------------------------------------
# Host interface binding. Default: 0.0.0.0
BACKEND_HOST=0.0.0.0

# Host port binding (for local dev). Default: 8000
BACKEND_PORT=8000

# Render dynamic runtime port (automatically injected by Render in production)
PORT=

# Allowed CORS origins (comma-separated). Set to frontend Render URL in production.
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost,https://civicpulse-ai-frontend.onrender.com

# Maximum request payload ceiling in bytes (10MB). Default: 10485760
MAX_BODY_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Engine Configuration (SERVER-SIDE SECRET ONLY)
# ------------------------------------------------------------------------------
# [SECRET] Google Gemini API Key for live AI natural language intelligence.
# WARNING: Store in Render Secrets Dashboard ONLY. NEVER expose to frontend.
# Behavior if blank/unconfigured: System automatically runs in Deterministic Rule-Based
# Fallback Mode (`RuleBasedLanguageIntelligenceProvider`) with script-aware NLP.
GEMINI_API_KEY=

# Target Gemini model identifier. Default: gemini-2.5-flash
GEMINI_MODEL_NAME=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Frontend Build Environment Variables
# ------------------------------------------------------------------------------
# Production target backend API base URL for Render frontend build
VITE_API_BASE_URL=https://civicpulse-ai-backend-ehvg.onrender.com
