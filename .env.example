# ==============================================================================
# CIVICPULSE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development.
# WARNING: DO NOT COMMIT REAL SECRETS OR API KEYS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Environment
# ------------------------------------------------------------------------------
# [Optional] Controls runtime mode ('development' or 'production'). Default: development
ENVIRONMENT=development

# [Optional] Log level ('DEBUG', 'INFO', 'WARNING', 'ERROR'). Default: INFO
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Backend Server & Security Configuration
# ------------------------------------------------------------------------------
# [Optional] Host interface binding. Default: 0.0.0.0
BACKEND_HOST=0.0.0.0

# [Optional] Host port binding. Default: 8000
BACKEND_PORT=8000

# [Optional] Allowed CORS origins (comma-separated). Default: http://localhost:5173,...
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# [Optional] Maximum request payload ceiling in bytes (10MB). Default: 10485760
MAX_BODY_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Engine Configuration
# ------------------------------------------------------------------------------
# [Optional] Google Gemini API Key for live AI natural language intelligence.
# Behavior if blank/unconfigured: System automatically runs in Deterministic Rule-Based
# Fallback Mode (`RuleBasedLanguageIntelligenceProvider`) with script-aware NLP.
GEMINI_API_KEY=

# [Optional] Target Gemini model identifier. Default: gemini-2.5-flash
GEMINI_MODEL_NAME=gemini-2.5-flash
